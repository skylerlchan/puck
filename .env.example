# Slack app credentials (Socket Mode). Copy to .env and fill in.
# Create an app at https://api.slack.com/apps -> enable Socket Mode.
SLACK_BOT_TOKEN=xoxb-your-bot-token       # OAuth & Permissions -> Bot User OAuth Token
SLACK_APP_TOKEN=xapp-your-app-token       # Basic Information -> App-Level Token (connections:write)

# GitHub + Claude are used via their CLIs (`gh auth login`, `claude` logged in),
# so no tokens are needed here.
